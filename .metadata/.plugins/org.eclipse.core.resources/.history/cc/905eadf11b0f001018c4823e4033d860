package com.example.E_Portal.serviceImpl;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.example.E_Portal.dto.EmployeeDto;
import com.example.E_Portal.model.Employee;
import com.example.E_Portal.repository.EmployeeRepo;
import com.example.E_Portal.service.EmployeeService;

@Service
public class EmployeeServiceImpl implements EmployeeService {
	
	@Autowired
	private EmployeeRepo employeeRepo;

	@Override
	public EmployeeDto addEmployee(EmployeeDto employeeDto) {
		
		String imageUrl = employeeDto.getImageUrl();
		if(imageUrl.isEmpty()) {
			if(employeeDto.getGender().toLowerCase() == "male") {
				employeeDto.setImageUrl("male_logo");
			}else {
				employeeDto.setImageUrl("female_logo");
			}	
		}
		
		Employee employee = EmployeeDto.toEntity(employeeDto);
		employeeRepo.save(employee);
		
		return employeeDto;
		
	}

}
