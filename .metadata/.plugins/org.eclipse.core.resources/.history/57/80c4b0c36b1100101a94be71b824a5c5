package com.example.E_Portal.serviceImpl;

import java.io.InputStream;
import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.stereotype.Service;
import org.springframework.web.multipart.MultipartFile;

import com.example.E_Portal.constant.Constant;
import com.example.E_Portal.service.BannerService;

import io.minio.MinioClient;
import io.minio.PutObjectArgs;
import io.minio.RemoveObjectArgs;
import io.minio.StatObjectResponse;

@Service
public class BannerServiceImpl implements BannerService {

	@Autowired
	private MinioClient minioClient;

	@Override
	public ResponseEntity<String> uploadBanner(MultipartFile banner) {
		try {
			// this folderName will store the image inside the folder
			String fileName = Constant.BANNERFOLDER_NAME + banner.getOriginalFilename();

			boolean bucketExists = minioClient
					.bucketExists(io.minio.BucketExistsArgs.builder().bucket(Constant.BUCKET_NAME).build());
			if (!bucketExists) {
				System.out.println("Bucket not found. Creating bucket: " + Constant.BUCKET_NAME);
				minioClient.makeBucket(io.minio.MakeBucketArgs.builder().bucket(Constant.BUCKET_NAME).build());
			}

			// Get the image input stream
			InputStream inputStream = banner.getInputStream();
			
			//check if the banner image exists in s3
//			StatObjectResponse imageIsExist = minioClient.statObject(
//					io.minio.StatObjectArgs.builder()
//					.bucket(Constant.BUCKET_NAME)
//					.object(fileName)
//					.build()
//			      );
			
//			if(imageIsExist != null) {
//				return ResponseEntity.status(HttpStatus.CONFLICT).body("Banner image already exist in s3: " + banner.getOriginalFilename());
//			}

			// Upload the file to s3
			minioClient.putObject(PutObjectArgs.builder()
					.bucket(Constant.BUCKET_NAME)
					.object(fileName)
					.stream(inputStream, banner.getSize(), -1)
					.contentType(banner.getContentType())
					.build()
				);
			
			return ResponseEntity.status(HttpStatus.OK).body("Banner image uploaded successfully: " + banner.getOriginalFilename());
		} catch (Exception e) {
			e.printStackTrace();
			return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR)
					.body("Banner image upload failed: " + e.getMessage());
		}
	}

	@Override
	public ResponseEntity<String> deleteBanner(String bannerImageName) {
		try {
			String fileName = Constant.BANNERFOLDER_NAME + bannerImageName;
			
			//check if the banner image exists in s3
			minioClient.statObject(
					io.minio.StatObjectArgs.builder()
					.bucket(Constant.BUCKET_NAME)
					.object(fileName)
					.build()
			      );
			
			RemoveObjectArgs object = RemoveObjectArgs.builder()
					.bucket(Constant.BUCKET_NAME)
					.object(fileName)
					.build();
			
			minioClient.removeObject(object);
			
			return ResponseEntity.status(HttpStatus.OK).body("Banner image deleted successfully: " + bannerImageName);
		}catch(Exception e) {
			e.printStackTrace();
			return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body("Banner image not found: " + e.getMessage());
		}
	}

