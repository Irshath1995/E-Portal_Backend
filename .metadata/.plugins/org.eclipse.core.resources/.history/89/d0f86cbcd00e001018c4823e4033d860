package com.example.E_Portal.controller;

import java.io.InputStream;
import java.sql.Blob;

import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;
import org.springframework.web.multipart.MultipartFile;

import com.example.E_Portal.minio.MinioConnection;

import io.minio.MinioClient;
import io.minio.PutObjectArgs;

@RestController
@RequestMapping("/employee")
public class Employee {
	public MinioConnection minioConnection = new MinioConnection();
	
	private MinioClient minioClient;
	private final String BUCKET_NAME = "employeeimages";
	
	public Employee() {
		this.minioClient = minioConnection.createConnection();
	}

	@PostMapping("/uploadImage")
	public String uploadImage(@RequestParam("empImage") MultipartFile empImage){
		try {
			// Get the image input stream
			InputStream inputStream = empImage.getInputStream();
			
			// Upload the file to s3
			minioClient.putObject(
					PutObjectArgs.builder()
					.bucket(BUCKET_NAME)
					.object(empImage.getOriginalFilename())
					.stream(inputStream, empImage.getSize(), -1)
					.contentType(empImage.getContentType())
					.build()
				);
			return "File uploaded successfully: " + empImage.getOriginalFilename();
		}catch(Exception e) {
			e.printStackTrace();
			return "File upload failed";
		}
	}
	
}
